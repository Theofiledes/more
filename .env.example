# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Required ---

# Auth token BMO's API requires on every request (Authorization: Bearer <token>).
# Required — the server refuses to start without one. Generate a real secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This is a SERVER-SIDE secret. It is never sent to the frontend and is never compiled
# into the client bundle or an APK — devices authenticate with their own pairing token
# instead (Settings > pairing). Treat this one as break-glass: it can run shell commands.
# (Formerly VITE_BMO_API_KEY. That name is still read so upgrades don't break, but it is
# deprecated — a VITE_ prefix invites exactly the leak this rename prevents.)
BMO_MASTER_TOKEN=

# --- Frontend (Vite) ---

# Where the frontend finds BMO's backend API. Defaults to http://localhost:18789 if unset.
# Leave unset for local dev; for phone/LAN/Tailscale access, prefer setting the server
# address at runtime in Settings > Server Address instead of baking an IP in here —
# anything VITE_-prefixed is compiled into the client bundle (and any built APK) in plaintext.
# VITE_BMO_API_URL=http://localhost:18789

# (Don't use VITE_GEMINI_API_KEY — set GEMINI_API_KEY further down instead. The old name
# is still read as a fallback so upgrades don't break, but it is deprecated: the cloud
# brain now goes through the server, so the key never has to reach the client, and a
# VITE_ var would be inlined in plaintext into every APK you build and share.)

# The name BMO calls you, shown on your messages and in its greeting. Defaults to "Player".
# There used to be a PIN lock screen in front of the app; it was cosmetic (the real access
# gate is device pairing) and mostly served to block new users on their first run,
# so it's gone. An old "Name:pin" value still works — the pin half is ignored.
# VITE_BMO_USERS=Player

# Sentry DSN for frontend error reporting. Absent by default (Sentry stays off).
# VITE_SENTRY_DSN=

# --- Backend (server.py) ---

# Which Ollama model to prefer. Leave unset to auto-detect any installed non-vision
# model. See README for how to pull/build a model for BMO.
# OLLAMA_MODEL=

# Ollama server address. Defaults to http://localhost:11434.
# OLLAMA_URL=http://localhost:11434

# Server-side Gemini key. Powers dream-synthesis memory distillation, cloud escalation,
# and the "GEM BMO" cloud chat mode. Optional — BMO is perfectly happy fully local.
# Stays on the server: it is never sent to the client or built into an APK.
# GEMINI_API_KEY=

# Which Gemini model to call. Defaults to gemini-3.7-flash. Avoid the
# "gemini-flash-latest" alias — it has its own quota pool that returns 429 even when
# pinned versions on the same key work fine. List what your key can reach with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# GEMINI_MODEL=gemini-3.7-flash

# Override the auto-detected project root (defaults to server.py's own directory).
# Only needed if you're running server.py from somewhere other than the repo root.
# WORKSPACE_DIR=

# Comma-separated list of origins allowed to call the API cross-origin (CORS). Defaults
# to the local Vite dev server + the API's own origin. Only matters for cross-origin
# requests — same-origin access (including over Tailscale/LAN once dist/ is built) is
# unaffected.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:18789,http://127.0.0.1:18789

# Set false to disable BMO's own git-checkpoint-before-shell-command behavior. Defaults
# to true (on).
# AUTO_CHECKPOINT=true

# Max size (MB) of scratch/ — BMO's cache for uploaded images. Oldest files are evicted
# first once this is exceeded. Defaults to 200.
# SCRATCH_MAX_MB=200

# Must match the model's real loaded context (see `ollama show <model>` /
# PARAMETER num_ctx in its Modelfile) — this doesn't change the model's actual context,
# it just keeps the UI's context gauge and history-trimming honest about what it is.
# Defaults to 16384.
# BMO_CONTEXT_LIMIT=16384

# Whisper model size for push-to-talk voice transcription. Only used if you've installed
# the optional voice dependency (see requirements-voice.txt) — ignored otherwise.
# tiny / base / small / medium / large-v3. Defaults to "base".
# WHISPER_MODEL_SIZE=base

# Once your devices are paired (Settings > pairing), set this to "off" to reject the
# shared token above and require a per-device token instead. Kept "on" by default so
# an existing install doesn't lock itself out on upgrade. Pair a device FIRST — with
# this off and no devices enrolled, restart the server to print a new pairing code.
# BMO_SHARED_TOKEN=on

# BMO distills memory during lulls rather than on a fixed clock, and abandons a dream
# the moment you start typing — on a small GPU it competes with chat for VRAM.
# DREAM_IDLE_SECONDS: quiet time before BMO may dream. Defaults to 600 (10 min).
# DREAM_MIN_GAP_SECONDS: floor between dreams regardless of idleness. Defaults to 1800.
# DREAM_IDLE_SECONDS=600
# DREAM_MIN_GAP_SECONDS=1800

# When BMO decides a thought needs a bigger brain than the local model, this controls
# whether it may ask the cloud. Escalating sends recent conversation to Google and costs
# money, so it defaults to "ask" rather than "auto".
#   off  - never leaves the device
#   ask  - BMO surfaces the request and waits for you (single-use approval)
#   auto - escalates freely, up to BMO_ESCALATION_BUDGET calls per day
# BMO_ESCALATION_MODE=ask
# BMO_ESCALATION_BUDGET=20

# How much BMO may say on its own after learning something.
#   off  - learn silently
#   note - may leave one short note about what it learned
#   full - may also ask questions or suggest next steps
# BMO_PROACTIVE_MODE=note

# How many learned facts are injected into every prompt. Each is ~30 tokens, while
# SOUL.md alone costs ~960 — memory is a much smaller context lever than it looks.
# BMO_MEMORY_FACTS=20

# Fact count at which BMO merges its memory into fewer, denser facts after a dream.
# Consolidation archives the old set (restore via POST /v1/memory/restore), and
# prefers the cloud: merging dozens of notes without losing information is a real
# reasoning task that small local models do poorly.
# BMO_MEMORY_CONSOLIDATE_AT=40

# By default BMO's write_file tool refuses paths outside its workspace, so a fresh
# install can't scatter files across your home directory. run_command can already write
# anywhere, so this is a guard rail rather than a security boundary — set it true if you
# use BMO across several project directories.
# BMO_ALLOW_EXTERNAL_WRITES=false

# Optional: real web search. Without a key BMO falls back to DuckDuckGo's free
# instant-answer API plus Wikipedia — fine for encyclopedic questions, but DDG returns
# nothing for most practical queries. Brave's free tier is ~2,000 searches/month:
#   https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# --- wake-bmo.sh ---

# Host uvicorn binds to. Defaults to 0.0.0.0 (reachable from your whole network) so
# phone/Tailscale access works out of the box. Set to 127.0.0.1 to restrict BMO — which
# can execute shell commands — to this machine only.
# BMO_BIND_HOST=0.0.0.0
